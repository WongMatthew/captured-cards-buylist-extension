{
  "manifest_version": 3,
  "name": "Captured! Cards - Buylist graphics",
  "short_name": "Buylist graphics",
  "version": "1.2.1",
  "description": "Edit the cards on capturedcards.com's \"We're buying\" list and make Instagram, story and website graphics from them.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Buylist graphics",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://capturedcards.myshopify.com/*",
    "https://capturedcards.com/*",
    "https://cdn.shopify.com/*",
    "https://shopify-staged-uploads.storage.googleapis.com/*",
    "https://storage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}